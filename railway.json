{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "/bin/sh -c \"python manage.py migrate --noinput && gunicorn mairin.wsgi --log-file -\"",
    "restartPolicyType": "ON_FAILURE"
  }
}
