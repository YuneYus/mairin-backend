{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "preDeployCommand": ["python manage.py migrate --noinput"],
    "startCommand": "gunicorn mairin.wsgi --log-file -",
    "restartPolicyType": "ON_FAILURE"
  }
}
