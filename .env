# Configuración del backend para desarrollo local.
# Este archivo está en el repo a propósito: con él el proyecto funciona sin configurar nada.
# En Railway NO se usa este archivo: allí se definen las variables reales en
# el panel del servicio (Variables), y esas tienen prioridad sobre este archivo.

SECRET_KEY=eKdfQp1LuWUzchPRKMKhFNQ2c4lZLSiDB2cjwi3S55M=
DEBUG=True
ALLOWED_HOSTS=*

# Vacío = usar SQLite local (db.sqlite3). En Railway se pone la URL de su Postgres.
DATABASE_URL=

# Solo hace falta en Railway, para entrar al panel /admin por HTTPS.
# Ejemplo: https://tu-app.up.railway.app
